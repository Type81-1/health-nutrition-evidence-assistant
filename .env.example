# Optional: improves PubMed E-utilities stability for repeated requests.
NCBI_EMAIL=
NCBI_API_KEY=

# Optional: set to true to enable Chroma semantic retrieval.
# Keep false for stable demos without model downloads.
ENABLE_CHROMA=false

# Optional: enables OpenAI-compatible answer generation.
# Without these values, the app falls back to deterministic template answers.
LLM_API_URL=
LLM_API_KEY=
LLM_MODEL=
