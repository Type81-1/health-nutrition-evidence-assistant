# ═══════════════════════════════════════════════════════
# 食证 · 环境变量配置模板
# ═══════════════════════════════════════════════════════
# 使用方法: 复制此文件为 .env 并填入真实值
#   cp .env.example .env
# ⚠️ .env 包含密钥，严禁提交到 Git！

# ── LLM 大语言模型（必填）────────────────────────────
# 支持任意 OpenAI-compatible API
# 推荐: DeepSeek (https://platform.deepseek.com)
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=sk-your-deepseek-api-key-here
LLM_MODEL=deepseek-chat

# ── 可选的替代 LLM ───────────────────────────────────
# 也可以使用其他 OpenAI-compatible 服务:
# OpenAI:     LLM_API_URL=https://api.openai.com/v1/chat/completions
#              LLM_MODEL=gpt-4o-mini
# 本地 Ollama: LLM_API_URL=http://localhost:11434/v1/chat/completions
#              LLM_MODEL=qwen2.5:7b

# ── Embedding 模型（可选，默认自动下载）───────────────
# 当前使用: sentence-transformers paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# ── PubMed / Europe PMC（可选，使用公共 API）─────────
# 无需额外配置，系统自动调用公开 API
# 如需提高频率限制，可申请 NCBI API Key:
# PUBMED_API_KEY=your-ncbi-api-key

# ── 服务端口（可选）──────────────────────────────────
# PORT=8000
# HOST=0.0.0.0
